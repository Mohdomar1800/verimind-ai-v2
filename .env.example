# Copy to .env and adjust. Every setting has a working default for Docker Compose.

# Postgres credentials used by the db container and the app.
POSTGRES_USER=verimind
POSTGRES_PASSWORD=verimind
POSTGRES_DB=verimind

# Port the web UI is published on (http://localhost:8000).
VERIMIND_PORT=8000

# Who can open VeriMind: 127.0.0.1 = only this computer (safest). 0.0.0.0 = anyone on your network.
VERIMIND_BIND=127.0.0.1

# debug | info | warning | error
VERIMIND_LOG_LEVEL=info

# Largest upload accepted, in MB.
VERIMIND_MAX_UPLOAD_MB=2048

# Only needed behind a reverse proxy: its public address, e.g. ["https://verimind.example.com"]
VERIMIND_ALLOWED_ORIGINS=[]

# Optional: enables AI-written summaries of failure clusters. Leave empty to run fully offline.
ANTHROPIC_API_KEY=
