# Keep line endings correct on every OS. Shell scripts with Windows line endings fail on macOS/Linux
# (and inside Docker), and .bat files need Windows line endings.
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
